{% if allow_attachments %}
    <div class="sp-attachment-details">
        <input type="hidden" name="attachment[]" disabled="disabled" />
        {% for attachment in message.attachments %}
            <input type="hidden" name="attachment[{{ attachment.upload_hash }}]"
                   id="attachment[{{ attachment.upload_hash }}]"
                   value="{{ attachment.original_name }}" />
        {% endfor %}
    </div>

    <ul class="sp-attached-files">
        <li class="sp:hidden">
            <div class="sp-file-information">
                <span class="sp-filename sp-truncate-middle"></span>

                <div class="sp-progress-bar">
                    <div class="sp-bar"></div>
                </div>
            </div>

            <div class="sp-delete-attachment sp:hidden" title="{{ Lang.get('general.remove') }}">
                <i class="fa-solid fa-times sp:text-white"></i>
            </div>
        </li>

        {% for attachment in message.attachments %}
            <li>
                <div class="sp-file-information">
                    <span class="sp-filename sp-truncate-middle" data-truncate="{{ attachment.original_name }}">{{ attachment.original_name }}</span>
                </div>

                <div class="sp-delete-attachment"
                     data-url="{{ route('ticket.operator.attachment.destroy') }}"
                     data-attachment-id="{{ attachment.id }}"
                     data-size="{{ attachment.upload.getRawOriginal('size') }}"
                     data-hash="{{ attachment.upload_hash }}"
                     data-silent="false"
                     title="{{ Lang.get('general.remove') }}">
                    <i class="fa-solid fa-times sp:text-white"></i>
                </div>
            </li>
        {% endfor %}
    </ul>

    <div class="sp-attachment-dragover sp:hidden">
        <div class="sp:m-auto">
            {{ Lang.get('general.drag_and_drop') }}
        </div>
    </div>
{% endif %}
