{% extends parent_template %}

{% block sidebar %}
    {% include 'operator.' ~ template ~ '.settings_sidebar' %}
{% endblock %}

{% block title %}
    {% if record|default is not empty and record.exists %}
        {{ Lang.get('general.edit_item', {'item': Lang.choice('core.api_token', 1)}) }}
    {% else %}
        {{ Lang.get('general.add_item', {'item': Lang.choice('core.api_token', 1)}) }}
    {% endif %}
{% endblock %}

{% block content %}

    {% if record|default is not empty and record.exists %}
        {{ form_model(record, { 'route': [ 'core.operator.apitoken.update', record.id ], 'method': 'PUT', 'class': 'validate' }) }}
    {% else %}
        {{ form_open({ 'route': 'core.operator.apitoken.store', 'class': 'validate' }) }}
    {% endif %}

        <div class="sp-form-container">

            <div class="sp-form-row">
                {{ form_label('name', Lang.get('general.name')) }}
                <div class="sp-input-container">
                    {{ form_text('name', null, {'autofocus': 'autofocus', 'size': 30}) }}
                </div>
            </div>

            <div class="sp-form-row">
                {{ form_label('token', Lang.get('core.token')) }}
                <div class="sp-input-container">
                    {% if not record.exists %}
                        {# Token not yet generated - it's created server side when the record is saved #}
                        <div class="sp-alert sp-alert-info">
                            {{ Lang.get('core.token_generate_after_create') }}
                        </div>
                    {% else %}
                        <div class="token-wrap sp:flex sp:items-center sp:gap-x-3">
                            <input type="text" class="token sp:font-mono" readonly="readonly" size="40"
                                   value="{{ revealedToken|default ?: maskedToken }}" />
                            <a class="copy {% if revealedToken|default is empty %}sp:hidden{% endif %}"
                               title="{{ Lang.get('general.copy') }}">
                                <i class="fa-solid fa-copy"></i>
                            </a>
                            <a class="regenerate" title="{{ Lang.get('core.regenerate_token') }}"
                               data-url="{{ route('core.operator.apitoken.regenerate_token', record.id) }}">
                                <i class="fa-solid fa-refresh"></i>
                            </a>
                        </div>
                        <div class="sp-alert sp-alert-warning token-once-alert sp:mt-3 sp:mb-0 {% if revealedToken|default is empty %}sp:hidden{% endif %}"
                             role="alert">
                            {{ Lang.get('general.copy_now_shown_once') }}
                        </div>
                    {% endif %}
                </div>
            </div>

            <div class="sp-form-row">
                <label>{{ Lang.get('core.access_level') }}</label>
                <div class="sp-input-container">
                    <label>
                        {{ form_radio('access', rw_access, true, {id: null}) }} {{ Lang.get('core.read_write')|raw }}
                    </label><br />
                    <label>
                        {{ form_radio('access', r_access, {id: null}) }} {{ Lang.get('core.read_only') }}
                    </label>
                </div>
            </div>

        </div>

        <div class="sp-form-button">
            {{ form_submit(Lang.choice("general.submit", 1)) }}
        </div>

    {{ form_close() }}

{% endblock %}

{% block scripts_footer %}
    {% if jsValidator|default is not empty %}
        {{ jsValidator|raw }}
    {% endif %}

    <script>
        $(function () {
            tippy('.copy', {content: '{{ Lang.get('general.copy') }}'});
            const copiedTippy = tippy('.copy', {
                trigger: 'manual',
                'content': '{{ Lang.get('general.copied') }}'
            })[0];

            const $wrap = $('.token-wrap');

            /**
             * After a token is revealed (regenerated), replace the input value with the full
             * plain-text token, show the copy button and the "copy now" warning.
             */
            function revealToken(plainToken) {
                $wrap.find('.token').val(plainToken);
                $wrap.find('.copy').removeClass('sp:hidden');
                $('.token-once-alert').removeClass('sp:hidden');
            }

            $wrap
                .on('click', '.copy', function () {
                    navigator.clipboard.writeText($(this).siblings('.token').val());
                    if (copiedTippy) {
                        copiedTippy.show();
                        setTimeout(() => copiedTippy.hide(), 1000);
                    }
                })
                .on('click', '.regenerate', function () {
                    const self = $(this);
                    Swal.fire({
                        title: Lang.get('messages.are_you_sure'),
                        html: '{{ Lang.get('core.change_token') }}',
                        icon: "warning",
                        showCancelButton: true,
                        confirmButtonColor: "#e74c3c",
                        confirmButtonText: Lang.get('messages.yes_im_sure'),
                        showLoaderOnConfirm: true,
                        preConfirm: function () {
                            return $.post(self.data('url'))
                                .done(function (res) {
                                    if (res.status === 'success') {
                                        revealToken(res.data.token);
                                    }
                                })
                                .always(() => Swal.close());
                        },
                        allowOutsideClick: function () {
                            return ! Swal.isLoading();
                        }
                    });
                });
        });
    </script>
{% endblock %}
