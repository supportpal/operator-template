{% if not article.getAttachments().isEmpty() %}
    <h4 class="sp:mt-6 sp:mb-0">{{ Lang.choice('general.attachment', 2) }}</h4>

    <div class="sp:print:hidden">
        <ul class="sp-attachments">
            {% for attachment in article.getAttachments() %}
                <li data-download-url="{{ attachment.downloadLink(type) }}" data-filename="{{ attachment.original_name }}">
                    <a class="{% if attachment.upload.isPreviewableVideo() or attachment.upload.isPreviewableAudio() or attachment.upload.isPreviewableImage() %}sp-attachment-preview {% endif %}"
                        {% if attachment.upload.isPreviewable() %}
                            data-download-url="{{ attachment.downloadLink(type) }}"
                            {% if attachment.upload.isPreviewableVideo() or attachment.upload.isPreviewableAudio() %}
                                data-video='{"source": [{"src":"{{ attachment.previewUrl(type, true) }}", "type":"{{ attachment.upload.mime }}"}], "attributes": {"preload": false, "controls": true}}'
                            {% else %}
                                href="{{ attachment.previewUrl(type, true) }}"
                                {% if not attachment.upload.isPreviewableImage() %}target="_blank"{% endif %}
                            {% endif %}
                        {% else %}
                            href="{{ attachment.downloadLink(type) }}"
                        {% endif %}>
                        <div class="sp-attachment-icon">
                            <div class="fiv-viv fiv-icon-{{ attachment.upload.icon }} sp:text-xl"></div>
                        </div>
                        <div class="sp-attachment-name sp-truncate-middle" data-truncate="{{ attachment.original_name }}" data-truncate-length="30">
                            {{ attachment.original_name }}
                        </div>
                        <div class="sp-attachment-size sp-description">{{ attachment.upload.size }}</div>
                    </a>
                </li>
            {% endfor %}
        </ul>
    </div>
    <div class="sp:hidden sp:print:block">
        <ul>
            {% for attachment in article.getAttachments() %}
                <li>
                    <a href='{{ attachment.downloadLink(type) }}'>{{ attachment.original_name }}</a>
                    <span class="sp-description">({{ attachment.upload.size }})</span>
                </li>
            {% endfor %}
        </ul>
    </div>
{% endif %}
